# ==============================================================================
# ApplyPilot Platform - Unified Root Environment Configuration (Example)
# ==============================================================================

# Server & Application Environment
PORT=5000
NODE_ENV=production
DOMAIN=jobs.rohanphulkar.com
LETSENCRYPT_EMAIL=admin@rohanphulkar.com

# MongoDB Database Settings
MONGODB_URI=mongodb://mongodb:27017/applypilot
MONGODB_DB_NAME=applypilot

# Redis Settings (BullMQ Queue)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Worker Settings
WORKER_CONCURRENCY=3
WORKER_ATTEMPTS=3
WORKER_BACKOFF_DELAY=5000

# OpenAI API Settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Resume Generator API Settings
RESUME_API_BASE_URL=http://resume-api:8001
RESUME_API_KEY=
RESUME_API_ENDPOINT=/api/resume/tailor

# Universal Email Provider Configuration (Gmail, Outlook, Spacemail, etc.)
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password-or-app-password

# SMTP Delivery Settings
SMTP_HOST=mail.spacemail.com
SMTP_PORT=587
SMTP_SECURE=false

# IMAP Sent Folder Sync Settings
IMAP_ENABLED=true
IMAP_HOST=mail.spacemail.com
IMAP_PORT=993
IMAP_SECURE=true

# AWS S3 Storage (For Tailored Resumes)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=applypilot-platform
S3_KEY_PREFIX=resumes
PRESIGNED_URL_EXPIRATION=604800
