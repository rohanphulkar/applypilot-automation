# =========================================================
# Resume Generator API Configuration Example
# =========================================================

# Server Settings
HOST=0.0.0.0
PORT=8001
DEBUG=False

# MongoDB Database Configuration
MONGODB_URI=mongodb://rohan:password@localhost:27017/resume_generator_db?authSource=admin
MONGODB_DB_NAME=resume_generator_db

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# AWS S3 Storage Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=applypilot-platform
S3_KEY_PREFIX=resumes
PRESIGNED_URL_EXPIRATION=604800
