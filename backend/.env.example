# =========================================================
# ApplyPilot - Environment Variables Configuration
# =========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/applypilot

# Redis Connection for BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# BullMQ Worker Settings
WORKER_CONCURRENCY=3
WORKER_ATTEMPTS=3
WORKER_BACKOFF_DELAY=5000

# OpenAI API Settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Resume Tailoring API (e.g. Python FastAPI Service)
RESUME_API_BASE_URL=http://localhost:8000
RESUME_API_KEY=
RESUME_API_ENDPOINT=/api/resume/tailor

# Universal Email Provider Credentials (Works with ANY email service: Gmail, Outlook, Spacemail, Custom)
# Gmail: user@gmail.com + App Password | SMTP: smtp.gmail.com:465 | IMAP: imap.gmail.com:993
# Outlook: user@outlook.com + App Password | SMTP: smtp.office365.com:587 (SECURE=false) | IMAP: outlook.office365.com:993
# Spacemail: user@spacemail.com + Password | SMTP: mail.spacemail.com:465 | IMAP: mail.spacemail.com:993
EMAIL_NAME=Rohan Phulkar
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_email_or_app_password

# Outbound SMTP Configuration
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true

# IMAP Configuration (Sent Folder Synchronization)
IMAP_ENABLED=true
IMAP_HOST=mail.spacemail.com
IMAP_PORT=993
IMAP_SECURE=true

# (Optional) Legacy Spacemail aliases for backward compatibility:
# SPACEMAIL_EMAIL=
# SPACEMAIL_PASSWORD=
# SPACEMAIL_SMTP_HOST=mail.spacemail.com
# SPACEMAIL_SMTP_PORT=465
# SPACEMAIL_SMTP_SECURE=true
# SPACEMAIL_IMAP_HOST=mail.spacemail.com
# SPACEMAIL_IMAP_PORT=993
# SPACEMAIL_IMAP_SECURE=true
